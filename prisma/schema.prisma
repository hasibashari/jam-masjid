datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Settings {
  id                String   @id @default(cuid())
  mosqueName        String   @default("Jam Masjid")
  latitude          Float    @default(21.4225) // Mecca default
  longitude         Float    @default(39.8262)
  calculationMethod Int      @default(4) // Umm Al-Qura Univ. default
  adzanDuration     Int      @default(180) // seconds (3 mins)
  iqomahDuration    Int      @default(600) // seconds (10 mins)
  prayerDuration    Int      @default(900) // seconds (15 mins)
  displayActive     Boolean  @default(true)
  displayStart      String   @default("03:00") // "HH:MM"
  displayEnd        String   @default("23:00") // "HH:MM"
  backgroundImage   String?
  backgroundActive  Boolean  @default(false)
}

model Banner {
  id            String   @id @default(cuid())
  title         String
  imageUrl      String
  description   String   @default("")
  active        Boolean  @default(true)
  autoHideAfter Int      @default(10) // display time in seconds
  createdAt     DateTime @default(now())
}
